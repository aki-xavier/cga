// 参数化板式办公楼 v2: CSG 开窗 + 砖纹贴图
// 验证点: difference() 在墙体上开真窗洞 (for 阵列减体),
//         material(map=) 纹理贴图 (box 立方体投影 UV)
// 注: module 体为词法作用域 (仅形参+pi), 参数需显式传递

background(color=0x87A8C8);
camera(fov=55, position=[15, 11, 20], target=[0, 5.5, 0]);

// ---- 标准层: 楼板 + 前后砖墙 (CSG 开窗) + 玻璃 + 柱列 ----
module storey(y, width, depth, floor_h, cols, bay) {
  slab_t = 0.35;
  win_w = bay - 1.1;  // 窗洞宽
  win_h = floor_h - 1.3;
  // 楼板
  translate([0, y, 0])
    material(color=0xC9C4BC, roughness=0.85) box(s=[width, slab_t, depth]);
  // 前后砖墙: 墙体减窗洞 (真开口)
  for (side = [-1:2:1]) {
    z = side * depth / 2;
    translate([0, y + floor_h / 2, z])
      material(color=0xB87462, roughness=0.9, map="assets/brick.png")
      difference() {
        box(s=[width, floor_h, 0.24]);
        for (j = [0:cols - 1]) {
          translate([-width / 2 + (j + 0.5) * bay, 0.15, 0])
            box(s=[win_w, win_h, 0.6]);   // 窗洞减体
        }
      }
    // 窗玻璃 (略内凹)
    for (j = [0:cols - 1]) {
      translate([-width / 2 + (j + 0.5) * bay, y + floor_h / 2 + 0.15, z])
        material(color=0x7FB2D9, roughness=0.12, metalness=0.55, emissive=0x0E1A26)
        box(s=[win_w - 0.1, win_h - 0.1, 0.06]);
    }
  }
  // 柱列
  for (j = [0:cols]) {
    x = -width / 2 + j * bay;
    translate([x, y + floor_h / 2, depth / 2])
      material(color=0xC9C4BC, roughness=0.85) box(s=[0.45, floor_h, 0.45]);
    translate([x, y + floor_h / 2, -depth / 2])
      material(color=0xC9C4BC, roughness=0.85) box(s=[0.45, floor_h, 0.45]);
  }
}

// ---- 屋面女儿墙 ----
module parapet(top, width, depth) {
  translate([0, top + 0.3, depth / 2 - 0.15])
    material(color=0xC9C4BC, roughness=0.85) box(s=[width, 0.6, 0.3]);
  translate([0, top + 0.3, -depth / 2 + 0.15])
    material(color=0xC9C4BC, roughness=0.85) box(s=[width, 0.6, 0.3]);
  translate([width / 2 - 0.15, top + 0.3, 0])
    material(color=0xC9C4BC, roughness=0.85) box(s=[0.3, 0.6, depth]);
  translate([-width / 2 + 0.15, top + 0.3, 0])
    material(color=0xC9C4BC, roughness=0.85) box(s=[0.3, 0.6, depth]);
}

// ---- 行道树 ----
module tree(x, z, s=1.0) {
  translate([x, 0.9 * s, z])
    material(color=0x6B4A2F, roughness=0.9)
    rotate(axis=[1, 0, 0], angle=-pi / 2) cylinder(r=0.12 * s, h=1.8 * s);
  translate([x, 2.1 * s, z])
    material(color=0x4E7A3A, roughness=0.85) sphere(r=0.9 * s);
}

// ---- 组装: 4 层 × 5 开间 ----
floors = 4; floor_h = 3.0; cols = 5; bay = 2.6;
depth = 8.0; width = cols * bay;

for (i = [0:floors - 1]) { storey(i * floor_h, width, depth, floor_h, cols, bay); }

parapet(floors * floor_h, width, depth);
translate([width / 4, floors * floor_h + 0.9, 0])
  material(color=0xB8B3AB, roughness=0.85) box(s=[2.2, 1.8, 3.0]);

// 入口雨棚 + 门斗
translate([0, floor_h + 0.1, depth / 2 + 1.0])
  material(color=0x8A8F94, roughness=0.35, metalness=0.7) box(s=[5.0, 0.15, 2.0]);
translate([0, floor_h / 2, depth / 2 + 0.4])
  material(color=0x2C3E50, roughness=0.2, metalness=0.3)
  box(s=[3.2, floor_h - 0.6, 0.8]);

material(color=0x9AA08E, roughness=0.95) plane(n=[0, 1, 0], d=0);
tree(9.5, 4.0);
tree(9.5, -2.0, 0.85);
tree(-8.5, 5.0, 1.1);

directional_light(direction=[0.5, 1.0, 0.45], intensity=0.55);
ambient_light(intensity=0.42);
