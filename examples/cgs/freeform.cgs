// 自由曲面 P3: bicubic Bezier 罩 + 厚曲面开槽 (CSG)
// 说明: 网格内核是暴力 O(N·F) 无 BVH, CSG 区间分类按 (rays × crossings) 采样,
// 高 div 宜配低分辨率/aa (本文件 320x240 aa=1 实测; hood/Cutter 提高 div 前先降分辨率)。
background(color=0x87CEEB);
camera(fov=50, position=[0, 2.8, 5.6], target=[0, 0.6, 0]);

material(color=0xB0B0B0, roughness=0.7) plane(n=[0, 1, 0], d=0);

hood = bezier(points=[[-1.5, -1.5, 0.175], [-1.5, -0.5, 0.275], [-1.5, 0.5, 0.275], [-1.5, 1.5, 0.175], [-0.5, -1.5, 0.275], [-0.5, -0.5, 0.375], [-0.5, 0.5, 0.375], [-0.5, 1.5, 0.275], [0.5, -1.5, 0.275], [0.5, -0.5, 0.375], [0.5, 0.5, 0.375], [0.5, 1.5, 0.275], [1.5, -1.5, 0.175], [1.5, -0.5, 0.275], [1.5, 0.5, 0.275], [1.5, 1.5, 0.175]], thickness=0.15, div=4);

translate([0, 1.35, 0]) rotate(axis=[1, 0, 0], angle=-1.5707963)
  material(color=0xC0392B, roughness=0.3, metalness=0.2) show(hood);

difference() {
  translate([0, 0.35, 0]) box(s=[3.2, 0.7, 3.2]);
  translate([0, 1.2, 0]) rotate(axis=[1, 0, 0], angle=-1.5707963)
    bezier(points=[[-1.5, -1.5, 0.175], [-1.5, -0.5, 0.275], [-1.5, 0.5, 0.275], [-1.5, 1.5, 0.175], [-0.5, -1.5, 0.275], [-0.5, -0.5, 0.375], [-0.5, 0.5, 0.375], [-0.5, 1.5, 0.275], [0.5, -1.5, 0.275], [0.5, -0.5, 0.375], [0.5, 0.5, 0.375], [0.5, 1.5, 0.275], [1.5, -1.5, 0.175], [1.5, -0.5, 0.275], [1.5, 0.5, 0.275], [1.5, 1.5, 0.175]], thickness=2.0, div=2);
}

directional_light(direction=[0.4, 1.0, 0.35], intensity=0.5);
ambient_light(intensity=0.35);
