// 仿射扩展: scale / mirror 经射线逆变换接入(非 versor 可达)
// 前排: 原盒 → 非均匀缩放 → 缩放与旋转任意嵌套; 后排: 非对称原件(右)与镜像件(左)
background(color=0x2B3138);
camera(fov=45, position=[0, 3.8, 10.6], target=[0, 0.3, -0.2]);
directional_light(direction=[0.4, 1.0, 0.35], intensity=0.5);
ambient_light(intensity=0.35);
material(color=0x3A4046, roughness=0.9) plane(n=[0, 1, 0], d=0);

translate([-3.2, 0.45, 1.5]) material(color=0x95A5A6, roughness=0.5) box(s=[0.9, 0.9, 0.9]);
translate([-1.4, 0.72, 1.5]) scale([0.6, 1.6, 0.6]) material(color=0x27AE60, roughness=0.45) box(s=[0.9, 0.9, 0.9]);
translate([1.1, 0.21, 1.5]) rotate(axis=[0, 1, 0], angle=0.6) scale([1.5, 0.45, 0.8]) material(color=0x2980B9, roughness=0.4) box(s=[0.9, 0.9, 0.9]);

// 非对称件: 偏心孔(x 向) + 角标金球; mirror(axis=[1,0,0]) ⇒ x → −x
material(color=0xC0392B, roughness=0.35) difference() {
  translate([2.3, 0.5, -2.2]) box(s=[1.0, 1.0, 1.0]);
  translate([2.58, 0.55, -2.2]) cylinder(r=0.26, h=1.6);
}
material(color=0xD4AC0D, roughness=0.4) translate([2.72, 1.12, -1.85]) sphere(r=0.16);
material(color=0xC0392B, roughness=0.35) mirror(axis=[1, 0, 0]) difference() {
  translate([2.3, 0.5, -2.2]) box(s=[1.0, 1.0, 1.0]);
  translate([2.58, 0.55, -2.2]) cylinder(r=0.26, h=1.6);
}
material(color=0xD4AC0D, roughness=0.4) mirror(axis=[1, 0, 0]) translate([2.72, 1.12, -1.85]) sphere(r=0.16);
