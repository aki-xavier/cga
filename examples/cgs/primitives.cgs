// 图元全家福: 前排 sphere / box / cylinder / cone (CGA blade),
// 后排 torus / tube(部分弧环) / ellipsoid / cyclide / circle — 全部为解析隐式面(非三角网格)
background(color=0x2B3138);
camera(fov=50, position=[0, 4.4, 9.6], target=[0, 0.2, -0.3]);
directional_light(direction=[0.4, 1.0, 0.35], intensity=0.5);
ambient_light(intensity=0.35);
material(color=0x3A4046, roughness=0.9) plane(n=[0, 1, 0], d=0);

// 前排: CGA blade 图元
translate([-3.3, 0.62, 1.0]) material(color=0xC0392B, roughness=0.25, metalness=0.2) sphere(r=0.62);
translate([-1.1, 0.5, 1.0]) rotate(axis=[0, 1, 0], angle=0.5) material(color=0x27AE60, roughness=0.5) box(s=[1.0, 1.0, 1.0]);
translate([1.1, 0.6, 1.0]) rotate(axis=[1, 0, 0], angle=-1.5707963) material(color=0xD4AC0D, roughness=0.35, metalness=0.25) cylinder(r=0.44, h=1.2);
translate([3.3, 0.6, 1.0]) rotate(axis=[1, 0, 0], angle=-1.5707963) material(color=0x2980B9, roughness=0.3) cone(r=0.55, h=1.2);

// 后排: 射线逆变换图元 + 渲染面
translate([-3.3, 0.24, -1.9]) material(color=0x8E44AD, roughness=0.3) torus(R=0.55, r=0.24);
translate([-1.1, 0.45, -1.9]) material(color=0x16A085, roughness=0.25) ellipsoid(radii=[0.7, 0.45, 0.55]);
translate([-0.25, 0.72, -1.9]) material(color=0xE91E63, roughness=0.3) torus(R=0.55, r=0.24, arc=4.2);
translate([3.3, 0.52, -2.1]) material(color=0xD35400, roughness=0.25) cyclide(a=0.5, b=0.49, d=0.45);
translate([1.4, 0.7, -1.9]) material(color=0xC2185B, roughness=0.4) circle(r=0.65);
