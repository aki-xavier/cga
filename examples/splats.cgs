// 高斯溅射层 (Gaussian splats): splats 修饰符示例
// 渲染: v -gc boehm run examples/render_cgs.v examples/splats.cgs examples/artifacts/splats_cgs.png 320 240 1
background(color=0x87CEEB);
camera(fov=50, position=[0, 2.0, 5.5], target=[0, 0, 0]);

// 地面
material(color=0xB0B0B0, roughness=0.7) plane(n=[0, 1, 0], d=-1.2);

// cyclide 环 + 溅射点层 (color 缺省继承物体材质色, 这里显式设为浅色)
material(color=0xC0392B, roughness=0.3)
  splats(n=1152, sigma_tangent=0.06, sigma_normal=0.015, color=0xECF0F1)
  cyclide(a=1.0, b=0.98, d=0.3);

// 蓝色椭球 + 溅射点层 (与实体共享 translate pose)
translate([2.3, 0.1, 0.4])
  material(color=0x2980B9, roughness=0.25)
  splats(n=500, sigma_tangent=0.07, sigma_normal=0.02, opacity=0.6, color=0xECF0F1)
  ellipsoid(radii=[0.9, 0.6, 0.7]);

directional_light(direction=[0.4, 1.0, 0.35], intensity=0.5);
ambient_light(intensity=0.35);
